# ── Wallet (only for the credential helper scripts) ──────────────────────
# Private key of your Polymarket account signer. Used by generate_creds.py
# and generate_perps_creds.py. The notifier itself never reads it.
PRIVATE_KEY=your_wallet_private_key

# ── Polymarket CLOB (prediction markets) ─────────────────────────────────
# Create with: python generate_creds.py
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_API_PASSPHRASE=your_api_passphrase
# Optional. Address of the signer that created the API key (the PRIVATE_KEY
# wallet). Enables REST backfill of fills missed while disconnected.
POLYMARKET_WALLET=

# ── Polymarket Perps ─────────────────────────────────────────────────────
# Create with: python generate_perps_creds.py   (credentials expire; default 7 days)
# Leave empty to disable Perps monitoring.
PERPS_PROXY_ADDRESS=
PERPS_PROXY_SECRET=

# ── Telegram (optional — terminal output only when empty) ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=123456789,987654321

# ── Behaviour ────────────────────────────────────────────────────────────
# Seconds before the first reconnect attempt; doubles up to MAX_RECONNECT_DELAY.
RECONNECT_DELAY=5
MAX_RECONNECT_DELAY=60
# Verify TLS certificates. Set to false only behind an intercepting corporate proxy.
SSL_VERIFY=true
# Max seconds to wait for a market-name lookup before sending the alert anyway.
NAME_LOOKUP_TIMEOUT=2
# On first start (no state file), look back this many seconds for missed fills.
BACKFILL_WINDOW=21600
# Where de-duplication state is stored.
STATE_FILE=state.json

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=trades.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
# Write every raw WebSocket frame to the log (needs LOG_LEVEL=DEBUG).
LOG_RAW_EVENTS=false
